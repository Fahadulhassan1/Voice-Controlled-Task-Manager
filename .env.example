# Environment Variables Template

# Backend Configuration
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Choose one: PostgreSQL or MongoDB
DATABASE_TYPE=postgresql  # or mongodb
DATABASE_URL=postgresql://user:password@localhost:5432/voice_task_manager
# For MongoDB: mongodb+srv://user:password@cluster.mongodb.net/voice_task_manager

# Claude API (Anthropic) - REQUIRED
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: OpenAI API (for advanced TTS/STT)
OPENAI_API_KEY=sk-xxx...

# JWT Configuration (for authentication)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Session Configuration
SESSION_SECRET=your_session_secret_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Voice Configuration
# STT Provider: web-speech-api, openai-whisper
STT_PROVIDER=web-speech-api
# TTS Provider: web-speech-api, openai
TTS_PROVIDER=web-speech-api

# Logging
LOG_LEVEL=debug  # debug, info, warn, error

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001

# Environment
NODE_ENV=development  # development, production, testing
